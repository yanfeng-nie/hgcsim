{
  "name": "hetero_lab",
  "description": "标准答题平台（调度赛道，硬件固定）：32 核服务器 CPU (AVX-512+AMX, CXL 3.0) + DDR5-4800 8 通道 256GB；L40S 级 GPU (48GB GDDR6)；昇腾级 NPU (64GB HBM, 经 CXL 3.0 挂在交换机下)；v5e 级 TPU；Alveo V80 级 FPGA；UPMEM 级近内存计算 (2560 DPU, DDR 总线)；SmartSSD 级可计算存储 (4TB)；RRAM / MRAM 存算一体加速卡；CXL 3.0 交换机下挂 512GB DRAM 内存扩展器与 1TB SCM 扩展器；PCIe 5.0 NVMe 8TB。",
  "host": {
    "id": "cpu0",
    "params": {
      "cores": 32,
      "freq_ghz": 3.0,
      "simd_bits": 512,
      "fma_units": 2,
      "amx": 1,
      "llc_mb": 120,
      "lfb_per_core": 16,
      "max_link_gen": 5,
      "cxl_max_version": 3.0
    },
    "memory": {
      "id": "dram0",
      "type": "DRAM",
      "params": {
        "channels": 8,
        "data_rate_mtps": 4800,
        "capacity_gb": 256
      }
    }
  },
  "switches": [
    {
      "id": "cxlsw0",
      "type": "CXL",
      "params": {
        "max_version": 3.0,
        "latency_ns": 120
      },
      "attach": {
        "to": "cpu0",
        "link": {
          "type": "CXL",
          "params": {
            "version": 3.0,
            "lanes": 16
          }
        }
      }
    }
  ],
  "devices": [
